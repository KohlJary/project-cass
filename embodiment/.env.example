# Cass Sensor Module Configuration

# Backend connection
CASS_BACKEND_URL=ws://localhost:8000/ws

# Display settings
DISPLAY_WIDTH=480
DISPLAY_HEIGHT=800

# User identity
USER_ID=sensor-module
DEVICE_NAME=Embodiment (Emulated)

# Audio
ENABLE_MIC=true
ENABLE_TTS=true
ENABLE_WAKE_WORD=true
# WAKE_WORD_MODEL=/path/to/custom/model.onnx
STT_MODEL=base  # tiny, base, small, medium, large-v2, large-v3

# Vision
ENABLE_FACE_RECOGNITION=true
ENABLE_GAZE_DETECTION=true
# FACE_BACKEND_URL=http://localhost:8000  # Defaults to HTTP version of CASS_BACKEND_URL
