# Cass Vessel Environment Configuration
# Copy this to .env and fill in your values

# ============================================
# Required: LLM API Keys (at least one)
# ============================================

# Anthropic Claude API Key (get from console.anthropic.com)
# Required for Cass conversations unless using Ollama/OpenAI
ANTHROPIC_API_KEY=your_anthropic_key_here

# OpenAI API Key (optional, for multi-LLM support)
OPENAI_ENABLED=false
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=4096

# ============================================
# Local LLM (Ollama) - Cost Savings
# ============================================
# Use local GPU for summarization, journaling, and optionally chat
# Saves Claude API costs for non-user-facing tasks

OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b-instruct-q8_0
OLLAMA_CHAT_MODEL=llama3.1:8b-instruct-q8_0

# Summarizer provider: "ollama" (local), "haiku" (Claude Haiku), "sonnet" (Claude Sonnet)
# Haiku recommended for quality while staying cost-effective
SUMMARIZER_PROVIDER=haiku

# ============================================
# Authentication & Security
# ============================================

# JWT secret - REQUIRED in production!
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=change_this_in_production_use_openssl_rand_hex_32

# Token expiration
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7

# Localhost bypass - allows TUI to work without auth during development
# Set to false in production when TUI has auth support
ALLOW_LOCALHOST_BYPASS=true
DEFAULT_LOCALHOST_USER_ID=your_user_uuid_here

# Demo mode - admin dashboard requires no authentication (read-only browsing)
# Enables "silent audience" use case for public viewing
DEMO_MODE=false

# ============================================
# External Services (Optional)
# ============================================

# GitHub token for metrics tracking (optional)
# Needs repo read access for commit/PR metrics
GITHUB_TOKEN=your_github_token_here

# Tavily API for web search (optional, for research features)
TAVILY_API_KEY=your_tavily_key_here

# NewsAPI.org for ambient news awareness (optional)
# Get free API key at newsapi.org (100 requests/day free tier)
NEWS_API_KEY=your_newsapi_key_here

# ============================================
# World State Consumption
# ============================================
# Cass reads and processes articles from news headlines

# Reading mode: "progressive" (paragraph-by-paragraph with revision) or "single_pass" (whole article at once)
# Single pass is more efficient for articles; progressive better for books/long-form content
WORLD_CONSUMPTION_READING_MODE=single_pass

# Budget limits
WORLD_CONSUMPTION_ARTICLES_PER_CYCLE=5
WORLD_CONSUMPTION_ARTICLES_PER_DAY=10
WORLD_CONSUMPTION_TOKENS_PER_DAY=50000

# Quality thresholds (0.0-1.0)
WORLD_CONSUMPTION_MIN_CONFIDENCE=0.5

# LLM model for analysis (haiku recommended for cost efficiency)
# Options: claude-haiku-4-5-20251001 (faster), claude-3-5-haiku-20241022 (fallback)
WORLD_CONSUMPTION_MODEL=claude-haiku-4-5-20251001

# ============================================
# Server Configuration
# ============================================

# Server host and port (defaults shown)
# HOST=0.0.0.0
# PORT=8000

# Data directory (defaults to ./data)
# DATA_DIR=/path/to/data

# Debug logging - set to true for verbose output
DEBUG=false

# ============================================
# System Integration
# ============================================

# Tmux socket path - needed when running as systemd service
# The default /tmp/tmux-1000/default is isolated by systemd's PrivateTmp
# Either disable PrivateTmp in systemd or set explicit socket path
# TMUX_SOCKET=/tmp/tmux-1000/default

# ============================================
# GeoCass (Daemon Homepage Hosting)
# ============================================

# Central hosting service for daemon homepages
# Sign up at geocass.hearthweave.org to get an API key
GEOCASS_URL=https://geocass.hearthweave.org
GEOCASS_API_KEY=your_geocass_api_key_here

# Discord Bot Configuration
DISCORD_BOT_TOKEN=your_token_here
DISCORD_ENABLED=true

# Optional: Restrict to specific servers (comma-separated guild IDs)
# Leave empty to allow all servers the bot joins
DISCORD_GUILDS=

# Optional: Snapshot interval in seconds (default: 300 = 5 min)
DISCORD_SNAPSHOT_INTERVAL=300

# Privacy: Don't log full message content (recommended)
DISCORD_CONTENT_LOGGING=false
