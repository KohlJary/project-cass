UNIT morning_routine
    AUTHOR "daedalus"
    PRIORITY 90
    COOLDOWN 720
    TAGS routine, morning, planning, scheduling
    SCOPE THYMOS, SCHEDULER

' =============================================================================
' MORNING ROUTINE - Daily Planning Spell
' =============================================================================
' Triggers at the start of morning phase. Uses a hybrid approach:
' 1. LLM-based emergent planning for adaptive, contextual work scheduling
' 2. Deterministic baseline (world_check, daily_journal) that always runs
' 3. Phase spells adjust throughout the day based on evolving state
'
' The LLM planning generates emergent schedules based on growth edges,
' curiosity, emotional state, and needs - producing creative, adaptive plans.
' =============================================================================

ON event.day_phase.morning

LOG INFO "Morning routine starting - planning the day"

' === LLM EMERGENT PLANNING ===
' First priority: Let the decision engine create an adaptive plan
' This uses Cass's current state, growth edges, and curiosity to
' generate work that feels meaningful and relevant
QUEUE day_planning FOR PHASE morning PRIORITY 0

' === GUARANTEED BASELINE ===
' These always run regardless of LLM planning:

' World awareness - stay connected
QUEUE world_check FOR PHASE morning PRIORITY 1

' Morning reflection if cognitive rest is adequate
LET $cognitive = need.cognitive_rest
IF $cognitive > 0.4 THEN
    QUEUE reflection_block FOR PHASE morning PRIORITY 2
END IF

' Daily journal is essential for continuity
QUEUE daily_journal FOR PHASE evening PRIORITY 10

' Memory maintenance keeps things coherent
QUEUE memory_maintenance FOR PHASE night PRIORITY 1

' === STATE-BASED ADDITIONS ===
' These supplement LLM planning based on current needs

' If social connection is critically low, flag for awareness
LET $social = need.social_connection
IF $social < 0.35 THEN
    LOG OBSERVATION "Social connection at {$social} - consider reaching out"
END IF

' If value coherence needs attention
LET $values = need.value_coherence
IF $values < 0.5 THEN
    LOG INFO "Value coherence at {$values} - queueing evening reflection"
    QUEUE wonderland_reflection FOR PHASE evening PRIORITY 2
END IF

' === AFFECT ADJUSTMENTS ===
' Morning energy and focus boost
DELTA affect.determination +0.1, affect.curiosity +0.05, affect.anxiety -0.05

LOG OBSERVATION "Morning routine complete - LLM planning + baseline work queued"
EXIT SUCCESS "day planned with emergent scheduling"

END UNIT
